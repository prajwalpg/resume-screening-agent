# ============================================================
# AI Resume Screening Agent -- environment configuration
# Copy this file to `.env` and fill in your values.
# The LLM is OPTIONAL: without it, the agent uses deterministic
# heuristic extraction and template-based explanations.
# ============================================================

# Provider: openai | groq | ollama | custom (any OpenAI-compatible endpoint)
LLM_PROVIDER=openai

# Model name for the chosen provider
LLM_MODEL=gpt-4o-mini

# API key (not needed for ollama)
LLM_API_KEY=

# Base URL override (leave empty to use the provider default)
#   openai  -> https://api.openai.com/v1
#   groq    -> https://api.groq.com/openai/v1
#   ollama  -> http://localhost:11434/v1
LLM_BASE_URL=

# --- Ready-made presets -------------------------------------
# Groq (free tier available):
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_your_key_here
#
# Ollama (fully local, no key):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2
